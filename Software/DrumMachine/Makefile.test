# Makefile.test — host build of the DrumMachine test runner.
#
# Per task 01:
#   - g++ -std=gnu++20 -O2 -g -Wall -Wextra -Werror
#   - Output: build/test/run_all
#   - Sources: test/main_test.cpp, test/test_*.cpp, test/support/*.cpp,
#              src/**/*.cpp (excluding Config.cpp, main.cpp, and Daisy*).
#   - Includes: src/, test/support/.
#   - clean removes build/.
#   - run target: build then exec the binary.

CXX      := g++
# DRUMMACHINE_HOST_TEST gates out libDaisy-dependent declarations (e.g. the
# daisy::Pin pin map in src/Config.h) so the same headers compile on the host.
CXXFLAGS := -std=gnu++20 -O2 -g -Wall -Wextra -Werror -DDRUMMACHINE_HOST_TEST
INCLUDES := -Isrc -Itest/support

# DaisySP source tree. Voices include their internal headers two ways:
#   - via the public path (e.g. "Drums/analogbassdrum.h") — root Source/ entry
#     covers this.
#   - via a bare filename (e.g. "dsp.h", "svf.h") — the .cpp files reference
#     siblings without a path, so each subdirectory used by the picked voices
#     must also be on the include path.
# All paths use -isystem so DaisySP's own diagnostics aren't promoted to errors
# by -Werror in this build.
DAISYSP_DIR     := ../GuitarPedal/dependencies/DaisySP/Source
DAISYSP_INCLUDE := -isystem $(DAISYSP_DIR) \
                   -isystem $(DAISYSP_DIR)/Drums \
                   -isystem $(DAISYSP_DIR)/Filters \
                   -isystem $(DAISYSP_DIR)/Noise \
                   -isystem $(DAISYSP_DIR)/PhysicalModeling \
                   -isystem $(DAISYSP_DIR)/Synthesis \
                   -isystem $(DAISYSP_DIR)/Utility
INCLUDES += $(DAISYSP_INCLUDE)

BUILD_DIR := build/test
BIN       := $(BUILD_DIR)/run_all

# ---- Source discovery --------------------------------------------------------
# Test sources: the runner entry point, all top-level test_*.cpp files, and any
# support helpers under test/support/.
TEST_SRCS := test/main_test.cpp \
             $(wildcard test/test_*.cpp) \
             $(wildcard test/support/*.cpp)

# Production sources: every src/**/*.cpp except the firmware-only seam files.
# We use shell `find` so newly added subdirectories are picked up automatically.
SRC_ALL  := $(shell find src -type f -name '*.cpp' 2>/dev/null)
SRC_SRCS := $(filter-out src/Config.cpp src/main.cpp \
                         src/controls/DaisyButton.cpp \
                         src/controls/DaisyLed.cpp, \
                         $(SRC_ALL))

# DaisySP sources compiled into the host test binary. Listed explicitly (not
# globbed) — the goal is to pull in only the four voices we wrap plus their
# transitive dependencies. Add new entries iteratively when link errors point
# to missing symbols.
DAISYSP_SRCS := $(DAISYSP_DIR)/Drums/analogbassdrum.cpp \
                $(DAISYSP_DIR)/Drums/analogsnaredrum.cpp \
                $(DAISYSP_DIR)/Drums/hihat.cpp \
                $(DAISYSP_DIR)/PhysicalModeling/modalvoice.cpp \
                $(DAISYSP_DIR)/PhysicalModeling/resonator.cpp \
                $(DAISYSP_DIR)/Synthesis/oscillator.cpp \
                $(DAISYSP_DIR)/Filters/svf.cpp

SRCS := $(TEST_SRCS) $(SRC_SRCS)
OBJS := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(SRCS)) \
        $(patsubst %.cpp,$(BUILD_DIR)/daisysp/%.o,$(notdir $(DAISYSP_SRCS)))
DEPS := $(OBJS:.o=.d)

# ---- Targets -----------------------------------------------------------------
.PHONY: all clean run
.DEFAULT_GOAL := all

all: $(BIN)

$(BIN): $(OBJS)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $@

$(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -MMD -MP -c $< -o $@

# DaisySP sources are compiled into a dedicated $(BUILD_DIR)/daisysp/ subdir so
# the basename collision risk between e.g. src/randomization/IRng.cpp and any
# similarly-named DaisySP file is structurally impossible.
#
# DaisySP has unused-parameter warnings, etc. that would fail under -Werror.
# `-isystem` only suppresses warnings for *headers*, not for translation units
# we're compiling ourselves — so we must drop -Werror on DaisySP.cpp's. We
# strip -Werror and turn off the warnings DaisySP itself trips so this stays
# noise-free even when DaisySP is updated.
DAISYSP_CXXFLAGS := $(filter-out -Werror -Wall -Wextra,$(CXXFLAGS)) -w
define DAISYSP_BUILD_RULE
$(BUILD_DIR)/daisysp/$(notdir $(1:.cpp=.o)): $(1)
	@mkdir -p $$(dir $$@)
	$$(CXX) $$(DAISYSP_CXXFLAGS) $$(INCLUDES) -MMD -MP -c $$< -o $$@
endef
$(foreach src,$(DAISYSP_SRCS),$(eval $(call DAISYSP_BUILD_RULE,$(src))))

run: $(BIN)
	./$(BIN)

clean:
	rm -rf build

-include $(DEPS)
